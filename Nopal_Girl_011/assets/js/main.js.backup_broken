    <script>
        // Navigation and mobile menu
        const nav = document.querySelector('nav');
        const mobileMenuToggle = document.getElementById('mobileMenu');
        const navLinks = document.getElementById('navLinks');
        let lastScrollY = window.scrollY;

        // Update nav on scroll
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
            lastScrollY = window.scrollY;
            updateActiveNavLink();
        });

        // Mobile menu toggle
        mobileMenuToggle.addEventListener('click', () => {
            navLinks.classList.toggle('active');
            mobileMenuToggle.classList.toggle('active');
            // Animate hamburger to X
            const spans = mobileMenuToggle.querySelectorAll('span');
            if (navLinks.classList.contains('active')) {
                spans[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
                spans[1].style.opacity = '0';
                spans[2].style.transform = 'rotate(-45deg) translate(5px, -5px)';
            } else {
                spans[0].style.transform = 'rotate(0) translate(0, 0)';
                spans[1].style.opacity = '1';
                spans[2].style.transform = 'rotate(0) translate(0, 0)';
            }
        });

        // Close mobile menu when clicking a link
        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', () => {
                navLinks.classList.remove('active');
                mobileMenuToggle.classList.remove('active');
                const spans = mobileMenuToggle.querySelectorAll('span');
                spans[0].style.transform = 'rotate(0) translate(0, 0)';
                spans[1].style.opacity = '1';
                spans[2].style.transform = 'rotate(0) translate(0, 0)';
            });
        });

        // Update active nav link based on scroll position
        function updateActiveNavLink() {
            const sections = document.querySelectorAll('section');
            let currentSection = '';

            sections.forEach(section => {
                const sectionTop = section.offsetTop - nav.offsetHeight - 16;
                const sectionHeight = section.clientHeight;
                const sectionId = section.getAttribute('id');

                if (pageYOffset >= sectionTop && pageYOffset < sectionTop + sectionHeight) {
                    currentSection = sectionId;
                }
            });

            document.querySelectorAll('.nav-links a').forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href').includes(currentSection)) {
                    link.classList.add('active');
                }
                // Handle home page specifically
                if (currentSection === 'home' && link.getAttribute('href') === '#home') {
                    link.classList.add('active');
                }
            });
        }

        // Run on load
        window.addEventListener('load', updateActiveNavLink);

        // Gallery loading function - SKELETON FOR EXTERNAL LINK
        // TODO: Replace the placeholder array with a fetch call to your external link
        // Example: fetch('YOUR_IMAGE_URL_LIST_ENDPOINT')
        //          .then(response => response.json())
        //          .then(imageUrls => loadGalleryImages(imageUrls))
        function loadGalleryImages() {
            const galleryGrid = document.getElementById('gallery-grid');

            // Show loading state
            galleryGrid.innerHTML = `
                <div class="gallery-loading">
                    Caricamento delle immagini in corso...
                </div>
            `;

            // Fetch images from Unsplash source (free, no API key needed for source)
// Using specific search terms for horse jumping/equestrian
            const imageUrls = [
                'https://source.unsplash.com/400x300/?horse,jumping',
                'https://source.unsplash.com/400x300/?horse,force',
                'https://source.unsplash.com/400x300/?equestrian,competition',
                'https://source.unsplash.com/400x300/?horse,riding',
                'https://source.unsplash.com/400x300/?show,jumping',
                'https://source.unsplash.com/400x300/?horse,training'
            ];

            // Titles and descriptions for each image
            const imageData = [
                {
                    title: 'Prima gara',
                    description: 'Il cuore batte forte davanti all\'ostacolo'
                },
                {
                    title: 'In volo',
                    description: 'Leggerezza e potenza in perfetto equilibrio'
                },
                {
                    title: 'Fiducia',
                    description: 'Un salto insieme, cavaliere e cavallo'
                },
                {
                    title: 'Determinazione',
                    description: 'Lo sguardo fisso sull\'obiettivo'
                },
                {
                    title: 'Eleganza',
                    description: 'Stile e grazia in ogni movimento'
                },
                {
                    title: 'Forza',
                    description: 'Potenza controllata e precisione'
                }
            ];

            // Simulate loading delay (remove in production when using real fetch)
            setTimeout(() => {
                // Clear loading state
                galleryGrid.innerHTML = '';

                // Create gallery items with actual Unsplash images
                imageUrls.forEach((url, index) => {
                    const galleryItem = document.createElement('div');
                    galleryItem.className = `gallery-item fade-in fade-in-delay-${index + 1}`;
                    galleryItem.innerHTML = `
                        <img src="${url}" alt="${imageData[index].title}">
                        <div class="gallery-caption">
                            <h3>${imageData[index].title}</h3>
                            <p>${imageData[index].description}</p>
                        </div>
                    `;
                    galleryGrid.appendChild(galleryItem);
                });
            }, 800); // Simulate network delay
        }

        // Initialize gallery
        document.addEventListener('DOMContentLoaded', loadGalleryImages);

        // Add subtle parallax effect to gallery items on mousemove
        document.addEventListener('mousemove', (e) => {
            const galleryItems = document.querySelectorAll('.gallery-item');
            galleryItems.forEach(item => {
                const rect = item.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                // Calculate position relative to center
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const deltaX = (x - centerX) / centerX;
                const deltaY = (y - centerY) / centerY;

                // Apply subtle 3D transform
                const rotateY = deltaX * 3; // Max 3 degrees
                const rotateX = -deltaY * 3; // Max 3 degrees

                item.style.transform = `translateY(0) rotateX(${rotateX}deg) rotateY(${rotateY}deg) perspective(1000px) scale(1)`;
            });
        });

        // Reset transform on mouse leave
        document.addEventListener('mouseleave', (e) => {
            const galleryItems = document.querySelectorAll('.gallery-item');
            galleryItems.forEach(item => {
                item.style.transform = 'translateY(0) rotateX(0) rotateY(0)';
            });
        });

        // Add click effect for gallery items
        document.addEventListener('click', (e) => {
            const galleryItem = e.target.closest('.gallery-item');
            if (galleryItem) {
                galleryItem.style.transform = 'scale(0.97)';
                setTimeout(() => {
                    galleryItem.style.transform = '';
                }, 150);
            }
        });

        // Create floating sparkles for extra magic
        (function() {
            const createSparkle = () => {
                const sparkle = document.createElement('div');
                sparkle.innerHTML = '✨';
                sparkle.style.position = 'fixed';
                sparkle.style.fontSize = Math.random() * 10 + 8 + 'px';
                sparkle.style.left = Math.random() * 100 + 'vw';
                sparkle.style.top = Math.random() * 100 + 'vh';
                sparkle.style.color = '#f8f4f0';
                sparkle.style.opacity = '0.5';
                sparkle.style.pointerEvents = 'none';
                sparkle.style.zIndex = '9999';

                // Animation
                sparkle.style.animation = `floatUp ${Math.random() * 3 + 2}s ease-out forwards`;

                document.body.appendChild(sparkle);

                // Remove after animation
                setTimeout(() => {
                    if (sparkle.parentNode) {
                        sparkle.parentNode.removeChild(sparkle);
                    }
                }, 5000);
            };

            // Create sparkles periodically
            setInterval(createSparkle, 2000);

            // Define CSS animation for sparkles
            const style = document.createElement('style');
            style.textContent = `
                @keyframes floatUp {
                    0% {
                        transform: translateY(0) rotate(0deg);
                        opacity: 0.5;
                    }
                    100% {
                        transform: translateY(-100vh) rotate(360deg);
                        opacity: 0;
                    }
                }
            `;
            document.head.appendChild(style);
        })();
// Theme toggle functionality
const themeToggle = document.getElementById('theme-toggle');
if (themeToggle) {
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const initialTheme = savedTheme || (prefersDark ? 'dark' : 'light');

    if (initialTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        themeToggle.innerHTML = '<i class="fas fa-sun"></i>';
        themeToggle.setAttribute('aria-label', 'Passa al tema chiaro');
        themeToggle.setAttribute('title', 'Tema chiaro');
    }

    themeToggle.addEventListener('click', () => {
        let newTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        if (newTheme === 'dark') {
            themeToggle.innerHTML = '<i class="fas fa-sun"></i>';
            themeToggle.setAttribute('aria-label', 'Passa al tema chiaro');
            themeToggle.setAttribute('title', 'Tema chiaro');
        } else {
            themeToggle.innerHTML = '<i class="fas fa-moon"></i>';
            themeToggle.setAttribute('aria-label', 'Passa al tema scuro');
            themeToggle.setAttribute('title', 'Tema scuro');
        }
    });
}
